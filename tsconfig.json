{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "strict": true,
    "skipLibCheck": true, "allowImportingTsExtensions": true,
    "resolveJsonModule": true, "noEmit": true, "types": ["node", "vite/client"]
  },
  "include": ["src", "server", "netlify", "scripts", "tests", "playwright.config.ts"]
}
